# Normalise line endings so Windows, macOS and Linux users do not fight over them.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.json    text
*.md      text
*.yml     text

*.sln     text eol=crlf
*.ps1     text eol=crlf
*.sh      text eol=lf

*.png     binary
*.jpg     binary
*.pdf     binary
